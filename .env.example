# APP_URL: The public URL where the application is hosted (optional in local development).
APP_URL="http://localhost:3000"

# Admin Authentication
# Set a strong, secret password for the single owner to access /admin
ADMIN_PASSWORD=

# Session Encryption Secret (at least 32 random characters for HMAC-SHA256 signing)
SESSION_SECRET=

# Optional Cloud Storage (for persistent snapshots across serverless deployments)
# If not provided, falls back to local file storage at data/published-journal.json
# KV_REST_API_URL=""
# KV_REST_API_TOKEN=""
